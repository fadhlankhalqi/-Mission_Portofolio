{
  "info": {
    "name": "Mission 8 - EduCourse API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "verificationToken", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullname\": \"User Mission 8\",\n  \"username\": \"user_mission8\",\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/register"
      }
    },
    {
      "name": "Login",
      "event": [{
        "listen": "test",
        "script": { "exec": ["const body = pm.response.json();", "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}" },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "Verify Email",
      "request": { "method": "GET", "url": "{{baseUrl}}/verify-email?token={{verificationToken}}" }
    },
    {
      "name": "Get Course - Filter Sort Search",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/course?topic=Programming&sortBy=harga_desc&search=node"
      }
    },
    {
      "name": "Upload Image",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
        "url": "{{baseUrl}}/upload"
      }
    }
  ]
}
